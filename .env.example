# pnpm run setup:local generates a local secret automatically. For production use a
# strong persistent secret. Never commit .env.local or paste secrets in chat.
AUTH_SECRET=

# demo = explicitly labeled evidence-only local demonstration, NOT an LLM.
# live = real AI SDK tool-calling agent + provider embeddings; errors never
# silently fall back to demo.
RESEARCH_MODE=demo
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Empty uses local, persistent PGlite PostgreSQL with pgvector.
POSTGRES_URL=
PGLITE_DATA_DIR=.data/local-postgres
GITHUB_TOKEN=

# Original Vercel Chatbot routes may use these optional upstream services.
AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=
REDIS_URL=
